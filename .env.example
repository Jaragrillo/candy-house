# Neon Postgres connection strings.
# DATABASE_URL: pooled (pgbouncer) — used by the app at runtime via the pg driver adapter.
# DATABASE_URL_UNPOOLED: direct connection — used only by the Prisma CLI (generate/migrate/studio).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Password to view /survey/resumen (results table).
SURVEY_ADMIN_PASSWORD="change-me"
